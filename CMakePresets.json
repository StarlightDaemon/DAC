{
  "version": 6,
  "configurePresets": [
    {
      "name": "msvc-release",
      "displayName": "MSVC x64 Release (VS 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc",
      "cacheVariables": { "DAC_BUILD_TESTS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "msvc-release", "configuration": "Release" },
    { "name": "debug", "configurePreset": "msvc-release", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "msvc-release", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "msvc-release", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ]
}
